# company-dd 环境变量示例：复制为 .env 并 source，或在 MCP 客户端里逐个配置。
# 密钥只从环境变量读取，不进日志、不落盘、不写进报告。

# 数据目录：默认 ~/.company-dd（company_dd/config.py 的 Config.home）。
# 只有想换位置时才取消注释并填绝对路径；留空/不设即为默认值。
# 注意：用仓库里的 ./bin/company-dd 启动时，它会把这个变量指向仓库内 data/，
# 因此报告可能落在仓库里而不是 ~/.company-dd —— 想固定位置就显式设这里。
# COMPANY_DD_HOME=/absolute/path/to/data

COMPANY_DD_TIMEOUT=20
COMPANY_DD_RETRIES=2
COMPANY_DD_HOST_INTERVAL=0.8
# SEC 要求 UA 里能联系到人，务必改成你自己的联系方式
COMPANY_DD_UA="company-dd-mcp/0.1 (+https://localhost/company-dd; contact: you@example.com)"

# ---- 可选：商业数据源（不配就是 needs_key，报告会如实标注）----
# DEVNORS_API_KEY=replace-with-your-key
# OPENCORPORATES_API_KEY=replace-with-your-key
# TYC_TOKEN=xxx        # 天眼查官方 CLI 登录后写入 ~/.tyc/config.json，一般无需手填
