#!/usr/bin/env bash
# company-dd 启动包装：固定用 venv 解释器，避免系统 Python 缺依赖。
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PY="$ROOT/.venv/bin/python"
if [ ! -x "$PY" ]; then
  echo "未找到 venv，先执行 bash $ROOT/install.sh" >&2
  exit 1
fi
export COMPANY_DD_HOME="${COMPANY_DD_HOME:-$ROOT/data}"
exec "$PY" -m company_dd.cli "$@"
